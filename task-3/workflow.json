    {
      "parameters": {
        "jsCode": "const aiContent = $input.first().json.choices[0].message.content;\nconst parsed = JSON.parse(aiContent);\nconst materialId = $('Parse Callback').first().json.material_id;\nconst chatId = $('Parse Callback').first().json.chat_id;\n\nreturn parsed.questions.map((q, idx) => ({\n  json: {\n    material_id: materialId,\n    chat_id: chatId,\n    idx: idx,\n    question: q.question,\n    options: q.options,\n    correct_answer: q.correctAnswer,\n    explanation: q.explanation,\n  },\n}));"
