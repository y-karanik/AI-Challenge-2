    {
      "parameters": {
        "jsCode": "const check = $('Check Answer').first().json;\nconst score = check.new_correct_count;\nconst total = check.total_questions;\nconst percent = Math.round((score / total) * 100);\nconst answers = check.answers || [];\n\nlet emoji = '🎉';\nif (percent < 50) {\n  emoji = '📚';\n} else if (percent < 80) {\n  emoji = '👍';\n}\n\nconst breakdown = answers\n  .map((a, i) => {\n    const mark = a.is_correct ? '✅' : '❌';\n    let line = `${mark} Q${i + 1}: ${a.question}\\nYour answer: ${a.user_answer}) ${a.options[a.user_answer]}`;\n    if (!a.is_correct) {\n      line += `\\nCorrect: ${a.correct_answer}) ${a.options[a.correct_answer]}\\n💬 ${a.explanation}`;\n    }\n    return line;\n  })\n  .join('\\n\\n');\n\nconst text = `${emoji} Quiz completed!\\n\\nYour score: ${score} / ${total} (${percent}%)\\n\\n— Breakdown —\\n\\n${breakdown}\\n\\nSend /quiz to try another topic or /learn <url> to add new material.`;\n\nreturn [{\n  json: {\n    chat_id: check.chat_id,\n    text: text,\n  },\n}];"
      },
