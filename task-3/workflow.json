        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-5.4-mini\",\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an Examiner AI. Generate exactly 5 multiple-choice quiz questions based on the educational material. Respond with valid JSON only in this exact shape: {\\\"questions\\\":[{\\\"question\\\":\\\"...\\\",\\\"options\\\":{\\\"A\\\":\\\"...\\\",\\\"B\\\":\\\"...\\\",\\\"C\\\":\\\"...\\\",\\\"D\\\":\\\"...\\\"},\\\"correctAnswer\\\":\\\"A\\\",\\\"explanation\\\":\\\"...\\\"}]}. Rules: exactly 5 questions, each with 4 options labeled A/B/C/D, correctAnswer is one of A/B/C/D, explanation explains why the correct answer is correct, all text in English, return ONLY the JSON object.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(\"Material title: \" + $json.title + \"\\n\\nSummary: \" + $json.summary + \"\\n\\nContent:\\n\" + $json.content.substring(0, 6000)) }}\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
