    {
      "parameters": {
        "jsCode": "const materials = $input.all().map(item => item.json);\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nif (materials.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      text: '📚 You have no saved materials yet.\\n\\nSend /learn <url> to add one.',\n      reply_markup: null,\n    },\n  }];\n}\n\nconst buttons = materials.map(m => [\n  { text: m.title, callback_data: `pick:${m.id}` },\n]);\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: '📚 Choose a topic for the quiz:',\n    reply_markup: { inline_keyboard: buttons },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
