    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst aiContent = item.choices[0].message.content;\nconst summary = JSON.parse(aiContent);\n\nconst extracted = $('Extract URL').first().json;\n\nreturn [{\n  json: {\n    chat_id: extracted.chat_id,\n    url: extracted.url,\n    title: summary.title,\n    difficulty: summary.difficulty,\n    key_points: summary.keyPoints,\n    main_concepts: summary.mainConcepts,\n    summary: summary.summary,\n    content: $('Fetch Content').first().json.data.substring(0, 4000),\n  },\n}];"
      },
