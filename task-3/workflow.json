        "jsCode": "const q = $input.first().json;\nconst chatId = $('Check Answer').first().json.chat_id;\nconst newIdx = $('Check Answer').first().json.new_idx;\n\nconst buttons = Object.entries(q.options).map(([letter, text]) => ([\n  { text: `${letter}) ${text}`, callback_data: `answer:${q.id}:${letter}` },\n]));\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: `❓ Question ${newIdx + 1} of 5\\n\\n${q.question}`,\n    reply_markup: { inline_keyboard: buttons },\n  },\n}];"
      },
