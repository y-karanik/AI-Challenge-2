    {
      "parameters": {
        "jsCode": "const question = $('Get Question').first().json;\nconst state = $('Get User State').first().json;\nconst parsed = $('Parse Callback').first().json;\n\nconst userAnswer = parsed.answer;\nconst isCorrect = userAnswer === question.correct_answer;\n\nconst newIdx = state.current_question_idx + 1;\nconst newCorrectCount = state.correct_count + (isCorrect ? 1 : 0);\nconst isLast = newIdx >= 5;\n\nconst prevAnswers = Array.isArray(state.answers) ? state.answers : [];\nconst updatedAnswers = [\n  ...prevAnswers,\n  {\n    question_id: question.id,\n    idx: state.current_question_idx,\n    question: question.question,\n    user_answer: userAnswer,\n    correct_answer: question.correct_answer,\n    is_correct: isCorrect,\n    explanation: question.explanation,\n    options: question.options,\n  },\n];\n\nconst feedback = isCorrect\n  ? `✅ Correct!\\n\\n${question.explanation}`\n  : `❌ Wrong. The correct answer was ${question.correct_answer}) ${question.options[question.correct_answer]}.\\n\\n${question.explanation}`;\n\nreturn [{\n  json: {\n    chat_id: parsed.chat_id,\n    callback_query_id: parsed.callback_query_id,\n    material_id: state.current_material_id,\n    is_correct: isCorrect,\n    is_last: isLast,\n    new_idx: newIdx,\n    new_correct_count: newCorrectCount,\n    total_questions: 5,\n    feedback_text: feedback,\n    answers: updatedAnswers,\n  },\n}];"
      },
