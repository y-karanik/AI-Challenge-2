      "parameters": {
        "jsCode": "const text = $input.first().json.message.text || '';\nconst match = text.match(/https?:\\/\\/[^\\s]+/);\n\nif (!match) {\n  throw new Error('No URL found in message');\n}\n\nreturn [{\n  json: {\n    url: match[0],\n    chat_id: $input.first().json.message.chat.id,\n  },\n}];"
      },
