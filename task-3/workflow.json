    {
      "parameters": {
        "jsCode": "const materials = $('Get Materials').all().map(item => item.json);\nconst history = $('Get History').all().map(item => item.json);\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nif (materials.length === 0) {\n  return [{\n    json: {\n      chat_id: chatId,\n      text: '📚 You have no saved materials yet.\\n\\nSend /learn <url> to add one.',\n      reply_markup: null,\n    },\n  }];\n}\n\nconst lastScoreByMaterial = {};\nfor (const h of history) {\n  const prev = lastScoreByMaterial[h.material_id];\n  if (!prev || new Date(h.completed_at) > new Date(prev.completed_at)) {\n    lastScoreByMaterial[h.material_id] = h;\n  }\n}\n\nconst buttons = materials.map(m => {\n  const last = lastScoreByMaterial[m.id];\n  const label = last\n    ? `${m.title} (last: ${last.score}/${last.total})`\n    : m.title;\n  return [{ text: label, callback_data: `pick:${m.id}` }];\n});\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    text: '📚 Choose a topic for the quiz:',\n    reply_markup: { inline_keyboard: buttons },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        -80
      ],
      "id": "0b49de2a-fd1d-4b23-af0b-ccef574ef1c3",
      "name": "Build Topic List"
    },
    {
      "parameters": {
        "jsCode": "const cq = $input.first().json.callback_query;\nconst data = cq.data || '';\nconst parts = data.split(':');\nconst action = parts[0]; \n\nreturn [{\n  json: {\n    chat_id: cq.message.chat.id,\n    callback_query_id: cq.id,\n    action: action,\n    material_id: action === 'pick' ? parseInt(parts[1]) : null,\n    question_id: action === 'answer' ? parseInt(parts[1]) : null,\n    answer: action === 'answer' ? parts[2] : null,\n  },\n}];"
      },
